# ============================================================
# SIG-LOG — Plantilla de variables de entorno
# Copiar este archivo como  .env  y completar los valores.
# ============================================================

# ---------- Opción 1 (recomendada): partes por separado ----------
# Mismo patrón usado en los ejercicios de clase (.env + quote_plus)
MONGO_USER=TU_USUARIO_ATLAS
MONGO_PASSWORD=TU_CONTRASENA
MONGO_CLUSTER=tucluster.xxxxx.mongodb.net
MONGO_DB=siglog

# ---------- Parámetros del sistema ----------
APP_ENTORNO=desarrollo
MONGO_TIMEOUT_MS=10000

# Nivel de validación de esquema de MongoDB al crear las colecciones:
#   warn  -> registra la violación pero permite la escritura (valor por defecto)
#   error -> rechaza el documento inválido
#   off   -> crea las colecciones sin validador
SIGLOG_VALIDACION=warn

# Índice geoespacial 2dsphere sobre clientes.direcciones.ubicacion.
# El documento técnico lo condiciona a "si se usa GPS" (regla pendiente).
# Se deja en false hasta que se confirme el uso de coordenadas.
SIGLOG_INDICE_GEO=false
